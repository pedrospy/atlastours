# Base de données PostgreSQL (Neon, Supabase, local…)
DATABASE_URL="postgresql://vitrina:vitrina@localhost:5432/vitrina?schema=public"

# URL publique du site (sans / final). Facultatif sur Vercel : l'adresse du projet est utilisée.
NEXT_PUBLIC_APP_URL="http://localhost:3040"

# Accès à l'espace /admin : choisissez votre propre mot de passe
ADMIN_PASSWORD="changez-moi"
# Facultatif : au moins 32 caractères aléatoires. Sans lui, la session est signée à partir d'ADMIN_PASSWORD.
AUTH_SECRET=""

# Objectif de chiffre d'affaires mensuel en euros (tableau de bord)
MONTHLY_GOAL="3000"

# Vos coordonnées (affichées aux clients et dans les messages WhatsApp)
OWNER_NAME="Yassine"
OWNER_WHATSAPP="212600000000"
OWNER_EMAIL="contact@vitrina.ma"

# Paiement manuel (virement)
BANK_NAME="CIH Bank"
BANK_HOLDER="Votre nom"
BANK_RIB="000 000 0000000000000000 00"

# Stripe (optionnel) : prix « paiement unique » pour chaque offre
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ESSENTIEL=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_PREMIUM=""
