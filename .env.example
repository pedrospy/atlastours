# Base URL used in payment redirects and emails
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# Postgres (Neon free tier works)
DATABASE_URL=postgresql://user:password@localhost:5432/arganis

# "stripe", "paypal" or "none" (booking requests without online payment).
# Read at build time for the booking button label, so rebuild after changing it.
# The deposit rate (30 %) lives in lib/booking/pricing.ts.
PAYMENT_PROVIDER=none

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# "sandbox" or "live"
PAYPAL_ENV=sandbox

RESEND_API_KEY=
RESEND_AUDIENCE_ID=
EMAIL_FROM="Arganis Nomad <reservations@arganisnomad.ma>"
ADMIN_EMAIL=contact@arganisnomad.ma

ADMIN_PASSWORD=

# Promo code offered to newsletter subscribers (5 % off)
PROMO_CODE=NOMAD5
