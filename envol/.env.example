# Base de données PostgreSQL (Neon, Supabase, local…)
DATABASE_URL="postgresql://envol:envol@localhost:5432/envol?schema=public"

# URL publique du site (sans / final). Facultatif sur Vercel : l'adresse du projet est utilisée.
NEXT_PUBLIC_APP_URL="http://localhost:3050"

# Accès à /admin
ADMIN_PASSWORD="changez-moi"
# Facultatif : au moins 32 caractères aléatoires. Sans lui, les sessions sont signées à partir d'ADMIN_PASSWORD.
AUTH_SECRET=""

# Vous, le formateur
OWNER_NAME="Yassine"
OWNER_WHATSAPP="212600000000"
OWNER_EMAIL="contact@envol-academie.com"
# Bio affichée sur la page de vente (section masquée si vide). Parlez de VOS résultats réels.
OWNER_BIO=""
# Forme juridique affichée dans les mentions légales (ex. « auto-entrepreneur, ICE 000000000000000 »)
LEGAL_ENTITY=""

# Objectif de chiffre d'affaires mensuel en euros (jauge du tableau de bord)
MONTHLY_GOAL_MIN="2500"
MONTHLY_GOAL_MAX="5000"

# Paiement manuel
BANK_NAME="CIH Bank"
BANK_HOLDER="Votre nom"
BANK_RIB="000 000 0000000000000000 00"
# Votre identifiant PayPal.me (ex. « yassinedev ») : génère un lien de paiement au bon montant
PAYPAL_ME=""

# Liens réservés aux élèves Pro / VIP
COACHING_LINK=""
COMMUNITY_LINK=""
VIP_BOOKING_LINK=""

# Stripe (optionnel) : paiement par carte avec ouverture automatique de l'accès
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
