{
  "name": "envol",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3050",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && ([ -z \"$DATABASE_URL\" ] || (prisma db push --skip-generate && node prisma/seed.mjs)) && next build",
    "start": "next start -p 3050",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.469.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
